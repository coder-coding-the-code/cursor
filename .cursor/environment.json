{
  "name": "ECS Guardian Trust",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "python3 -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -e \".[dev]\"",
  "terminals": [
    {
      "name": "guardian-trust",
      "command": ".venv/bin/python -m guardian_trust serve --host 0.0.0.0 --port 8080",
      "description": "Guardian Trust FastAPI service + web console on http://localhost:8080. Seeds the 星河智造 demo trust graph on startup."
    }
  ],
  "ports": [
    { "name": "guardian-trust web/api", "port": 8080 }
  ]
}
